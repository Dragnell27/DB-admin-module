{
  "name": "admin-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Panel de administración OTT (admin-frontend) — Next.js + TypeScript + Tailwind + shadcn/ui",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n backend,frontend -c blue,green \"cd ../admin-backend && go run ./cmd/api\" \"next dev\"",
