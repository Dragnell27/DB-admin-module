# ============================================================
# admin-frontend (Next.js) — Variables de entorno de ejemplo
# Copia este archivo a `.env.local` y completa los valores reales.
# NO incluir secretos reales en este archivo (.env.example).
# ============================================================

# URL base del admin-backend (BFF). El frontend habla ÚNICAMENTE con el BFF.
# Debe exponerse con el prefijo NEXT_PUBLIC_ para ser accesible en el navegador.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8081
