# ============================================================
# admin-backend (BFF Go + Gin) — Variables de entorno de ejemplo
# Copia este archivo a `.env` y completa los valores reales.
# NO incluir secretos reales en este archivo (.env.example).
# ============================================================

# ----- Servidor HTTP -----
PORT=8081
# Origen permitido para CORS (URL del admin-frontend)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ----- Base de datos (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin_ott
DB_PASSWORD=changeme
DB_NAME=admin_ott
DB_SSLMODE=disable

# ----- JWT de sesión del admin -----
# Secreto para firmar el JWT de sesión. Usa un valor largo y aleatorio en cada ambiente.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_EXPIRES_MINUTES=480

# ----- Cifrado del constructor de módulos (module-builder) -----
# Clave AES-256 (32 bytes) en base64 para cifrar en reposo las credenciales de
# los orígenes de datos de los módulos. Genera una por ambiente, p. ej.:
#   openssl rand -base64 32
# Opcional: si se deja vacía, la feature module-builder no podrá cifrar/descifrar.
MODULE_SECRETS_KEY=

# ----- Hashing de contraseñas -----
BCRYPT_COST=12

# ----- Seed del administrador inicial -----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_ROLE=admin

# ----- Integración con el backend OTT -----
# La autenticación y los recursos OTT viven en hosts distintos:
#   - OTT_AUTH_BASE_URL: base del endpoint de autenticación (POST /authenticate).
#   - OTT_BASE_URL:      base de los recursos (customers/plans/subscriptions/cards).
# Si OTT_AUTH_BASE_URL se deja vacío, se usa OTT_BASE_URL para autenticar.
OTT_AUTH_BASE_URL=https://api-qa-paymentgp.portalpagoscenam.com/api/v1
OTT_BASE_URL=https://api-ott-qa.portalpagoscenam.com
# País activo del BFF. Debe ser uno de: gt, sv, ni, hn, cr
# Mapeo moneda↔país esperado por OTT: gt=GTQ, sv=USD, hn=HNL, ni=NIO, cr=CRC
OTT_ACTIVE_COUNTRY=gt

# ----- Credenciales OTT por país -----
# Un par clientId/clientSecret por país del conjunto {gt, sv, ni, hn, cr}.
# Rellena únicamente los países que vayas a usar.
OTT_GT_CLIENT_ID=39337f53-ae29-44e8-8433-ad2e17627273
OTT_GT_CLIENT_SECRET=68602715eb65548b14899f485716cb79ea09b14a4999927c9c6e1a470a514137
OTT_SV_CLIENT_ID=
OTT_SV_CLIENT_SECRET=
OTT_NI_CLIENT_ID=
OTT_NI_CLIENT_SECRET=
OTT_HN_CLIENT_ID=
OTT_HN_CLIENT_SECRET=
OTT_CR_CLIENT_ID=
OTT_CR_CLIENT_SECRET=
