# ============================================================
# panel-admin-ott — Variables de entorno para Docker Compose (RAÍZ)
# ------------------------------------------------------------
# Copia este archivo a `.env` y completa los valores reales:
#     cp .env.example .env
# Luego levanta la solución:
#     docker compose up --build
#
# Este `.env` es el ÚNICO que lee `docker-compose.yml`. Agrupa:
#   - credenciales del servicio db (PostgreSQL),
#   - la configuración del admin-backend (BFF),
#   - el build arg del admin-frontend (URL pública del BFF).
#
# NO incluir secretos reales en este archivo (.env.example).
# El `.env` real está excluido por .gitignore; solo se versiona .env.example.
# ============================================================

# ------------------------------------------------------------
# Servicio db (PostgreSQL)
# ------------------------------------------------------------
# Estas credenciales inicializan el contenedor de PostgreSQL y DEBEN coincidir
# con las variables DB_* del admin-backend (comparten la misma base de datos).
POSTGRES_USER=admin_ott
POSTGRES_PASSWORD=changeme
POSTGRES_DB=admin_ott

# ------------------------------------------------------------
# admin-backend (BFF Go + Gin)
# ------------------------------------------------------------
# Servidor HTTP
PORT=8081
# Origen permitido para CORS (URL pública del admin-frontend)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Conexión a la base de datos. En Compose el host es el nombre del servicio `db`.
# DB_USER / DB_PASSWORD / DB_NAME DEBEN coincidir con POSTGRES_* de arriba.
DB_HOST=db
DB_PORT=5432
DB_USER=admin_ott
DB_PASSWORD=changeme
DB_NAME=admin_ott
DB_SSLMODE=disable

# JWT de sesión del admin. Usa un valor largo y aleatorio en cada ambiente.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_EXPIRES_MINUTES=480

# Hashing de contraseñas (coste bcrypt)
BCRYPT_COST=12

# Seed del administrador inicial (usado por `docker compose run --rm admin-backend /app/seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_ROLE=admin

# ------------------------------------------------------------
# Integración con el backend OTT (hub-services-ott)
# ------------------------------------------------------------
# La autenticación y los recursos OTT viven en hosts distintos:
#   - OTT_AUTH_BASE_URL: base del endpoint de autenticación (POST /authenticate).
#   - OTT_BASE_URL:      base de los recursos (customers/plans/subscriptions/cards).
OTT_AUTH_BASE_URL=https://api-qa-paymentgp.portalpagoscenam.com/api/v1
OTT_BASE_URL=https://api-ott-qa.portalpagoscenam.com
# País activo del BFF. Debe ser uno de: gt, sv, ni, hn, cr
# Mapeo moneda↔país esperado por OTT: gt=GTQ, sv=USD, hn=HNL, ni=NIO, cr=CRC
OTT_ACTIVE_COUNTRY=gt

# Credenciales OTT por país del conjunto {gt, sv, ni, hn, cr}.
# Rellena únicamente los países que vayas a usar.
OTT_GT_CLIENT_ID=
OTT_GT_CLIENT_SECRET=
OTT_SV_CLIENT_ID=
OTT_SV_CLIENT_SECRET=
OTT_NI_CLIENT_ID=
OTT_NI_CLIENT_SECRET=
OTT_HN_CLIENT_ID=
OTT_HN_CLIENT_SECRET=
OTT_CR_CLIENT_ID=
OTT_CR_CLIENT_SECRET=

# ------------------------------------------------------------
# admin-frontend (Next.js) — build arg
# ------------------------------------------------------------
# URL base del admin-backend tal como la ve el navegador del usuario
# (no la red interna de Compose). El frontend habla ÚNICAMENTE con el BFF.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8081
